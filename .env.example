# Radar IA — variables de entorno
# Copiar a .env.local y llenar con las keys reales. NUNCA compartir estas keys
# ni el proyecto de Supabase/Vercel con MaskotIA (ver 03-ARQUITECTURA-TECNICA.md).

# --- Supabase (proyecto radar-ia, separado de MaskotIA) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (multi-moneda: MXN, COP, CLP, PEN, ARS + Adaptive Pricing) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LITE=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
STRIPE_SETUP_FEE_PRICE_ID_LITE=
STRIPE_SETUP_FEE_PRICE_ID_PLUS=
STRIPE_SETUP_FEE_PRICE_ID_PRO=
STRIPE_SETUP_FEE_PRICE_ID_ENTERPRISE=

# --- WhatsApp Cloud API (canal principal de notificación/OTP) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- APIs de IA (motor de medición — el corazón del producto) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# --- Groq (procesamiento intermedio barato: parseo/clasificación, nunca la medición final) ---
GROQ_API_KEY=

# --- Google Places API (pilar 2, nivel 1: aproximación pública de GBP para auditoría
# gratis/competidores) --- Distinta de GOOGLE_AI_API_KEY (esa es Generative Language /
# Gemini). Debe ser una key restringida solo a Places API, con facturación activa en el
# proyecto de Google Cloud (uso normal cae dentro del crédito gratuito mensual de Maps
# Platform). Ver src/lib/audit/gbp.ts.
GOOGLE_PLACES_API_KEY=

# --- Bing Webmaster Tools API (señal de indexación en el pilar 3 — SOLO para sitios que
# el cliente verifique en esta cuenta de Bing; no aporta al pilar 8, ver
# 03-ARQUITECTURA-TECNICA.md sección Bing/Copilot) ---
BING_WEBMASTER_API_KEY=

# --- Endpoint interno /api/measure (dispara M2 manualmente; pega APIs de pago) ---
INTERNAL_MEASURE_SECRET=

# --- Resend (email transaccional / reportes) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Google Merchant Center (Fase 3 / M14, no bloquea Fase 1) ---
GOOGLE_MERCHANT_CENTER_ACCOUNT_ID=
GOOGLE_MERCHANT_CENTER_CLIENT_EMAIL=
GOOGLE_MERCHANT_CENTER_PRIVATE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://radar.omniflowcreator.com
